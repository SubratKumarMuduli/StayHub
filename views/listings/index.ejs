<% layout("/layouts/boilerplate") -%>
<body>
    <h3>All Listings</h3>
    <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-1">
        <% for(let i=0;i<result.length; i++){ %>
            <a href="/listings/<%= result[i]._id %>">
    <div class="card">
  <img src="<%= result[i].image %>" class="card-img-top indeximg" alt="listing_image" style="height: 20rem">
  <div class="card-body">
    <b><h5 class="card-text"><%= result[i].title %></h5></b>
    <p class="card-text">&#8377; <%= result[i].price.toLocaleString('en-IN') %> / night</p>
  </div>
  </div>
  </a>
 <% } %>
    </div>
</body>