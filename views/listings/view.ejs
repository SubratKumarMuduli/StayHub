<% layout("/layouts/boilerplate") -%>
<body>
  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3>Listing Details :</h3>

      <div class="card">
        <img
          src="<%= list.image %>"
          class="card-img-top viewimg"
          alt="listing_image"
        />
        <div class="card-body">
          <h5 class="card-text"><%= list.title %></h5>
          <p><%= list.description %></p>
          <p>&#8377; <%= list.price.toLocaleString('en-IN') %> / night</p>
          <p><%= list.location %>, <%= list.country %></p>
        </div>
      </div>
      <div class="buttons mt-3">
        <form action="/listings/<%= list._id %>/edit" method="get">
          <button class="edit btn btn-dark">Edit</button>
        </form>
        <br />
        <form action="/listings/<%= list._id %>?_method=DELETE" method="post">
          <button class="delete btn btn-danger">Delete</button>
        </form>
      </div>
    </div>
  </div>
</body>
